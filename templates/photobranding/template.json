{
    "id": "photobranding",
    "name": "PHOTOBRANDING",
    "description": "Branding fotografií organizace logem a volitelným modrým filtrem.",

    "canvas": {
        "width": 1080,
        "height": 1350,
        "background": "#000000"
    },

    "fields": [
        {
            "id": "format",
            "type": "select",
            "label": "Formát",
            "options": [
                {
                    "value": "post-1-1",
                    "label": "Instagram Post 1:1"
                },
                {
                    "value": "post-4-5",
                    "label": "Instagram Post 4:5"
                },
                {
                    "value": "story",
                    "label": "Instagram Story"
                }
            ],
            "default": "post-4-5"
        },

        {
            "id": "photos",
            "type": "image",
            "label": "Fotografie",
            "accept": "image/*",
            "multiple": true,
            "required": true
        },

        {
            "id": "photoHorizontal",
            "type": "range",
            "label": "Horizontální pozice fotografie",
            "min": 0,
            "max": 100,
            "step": 1,
            "default": 50
        },

        {
            "id": "photoVertical",
            "type": "range",
            "label": "Vertikální pozice fotografie",
            "min": 0,
            "max": 100,
            "step": 1,
            "default": 50
        },

        {
            "id": "logoVisible",
            "type": "checkbox",
            "label": "Zobrazit logo",
            "default": true
        },

        {
            "id": "logoVariant",
            "type": "select",
            "label": "Varianta loga",
            "options": [
                {
                    "value": "white",
                    "label": "Bílé"
                },
                {
                    "value": "blue",
                    "label": "Modré"
                }
            ],
            "default": "white",
            "visibleWhen": {
                "field": "logoVisible",
                "equals": true
            }
        },

        {
            "id": "logoPosition",
            "type": "position",
            "label": "Pozice loga",
            "options": [
                {
                    "value": "bottom-left",
                    "label": "Vlevo dole"
                },
                {
                    "value": "bottom-center",
                    "label": "Uprostřed dole"
                },
                {
                    "value": "bottom-right",
                    "label": "Vpravo dole"
                }
            ],
            "default": "bottom-center",
            "visibleWhen": {
                "field": "logoVisible",
                "equals": true
            }
        },

        {
            "id": "blueFilter",
            "type": "checkbox",
            "label": "Použít modrý filtr",
            "default": false
        },

        {
            "id": "filterOpacity",
            "type": "range",
            "label": "Průhlednost filtru",
            "min": 0,
            "max": 100,
            "step": 1,
            "default": 81,
            "visibleWhen": {
                "field": "blueFilter",
                "equals": true
            }
        }
    ],

    "photoBranding": {
        "formats": {
            "post-1-1": {
                "width": 1080,
                "height": 1080
            },
            "post-4-5": {
                "width": 1080,
                "height": 1350
            },
            "story": {
                "width": 1080,
                "height": 1920
            }
        },

        "photo": {
            "fit": "cover",
            "horizontalField": "photoHorizontal",
            "verticalField": "photoVertical"
        },

        "logo": {
            "assetPath": "Images/Logo",

            "variants": {
                "white": "logo-white-original.svg",
                "blue": "logo-blue-original.svg"
            },

            "box": {
                "x": 0,
                "y": 0,
                "width": 158,
                "height": 198
            },

            "fit": "contain",

            "position": {
                "field": "logoPosition",

                "positions": {
                    "bottom-left": {
                        "x": 37,
                        "y": 1111
                    },
                    "bottom-center": {
                        "x": 461,
                        "y": 1111
                    },
                    "bottom-right": {
                        "x": 885,
                        "y": 1111
                    }
                }
            }
        },

        "filter": {
            "color": "#014EA1",
            "opacityField": "filterOpacity",
            "enabledField": "blueFilter"
        }
    }
}
